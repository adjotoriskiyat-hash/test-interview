<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Bincom Test - Question 2</title>
                <style>
                        body { font-family: -apple-system, sans-serif; padding: 20px; background-color: #f4f4f9; }
                                .container { max-width: 600px; margin: 0 auto; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
                                        select { width: 100%; padding: 10px; margin-bottom: 20px; border-radius: 4px; }
                                                table { width: 100%; border-collapse: collapse; margin-top: 20px; }
                                                        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
                                                                th { background-color: #28a745; color: white; }
                                                                    </style>
                                                                    </head>
                                                                    <body>
                                                                        <div class="container">
                                                                                <h2>Total Results by Local Government (LGA)</h2>
                                                                                        
                                                                                                <form method="GET" action="/question2">
                                                                                                            <select name="lga_id" onchange="this.form.submit()">
                                                                                                                            <option value="">-- Select a Local Government --</option>
                                                                                                                                            <% lgas.forEach(lga => { %>
                                                                                                                                                                <option value="<%= lga.lga_id %>" <%= selectedLga == lga.lga_id ? 'selected' : '' %>>
                                                                                                                                                                                        <%= lga.lga_name %>
                                                                                                                                                                                                            </option>
                                                                                                                                                                                                                            <% }) %>
                                                                                                                                                                                                                                        </select>
                                                                                                                                                                                                                                                </form>

                                                                                                                                                                                                                                                        <% if (selectedLga && results.length > 0) { %>
                                                                                                                                                                                                                                                                    <table>
                                                                                                                                                                                                                                                                                    <thead>
                                                                                                                                                                                                                                                                                                        <tr>
                                                                                                                                                                                                                                                                                                                                <th>Political Party</th>
                                                                                                                                                                                                                                                                                                                                                        <th>Total Summed Score</th>
                                                                                                                                                                                                                                                                                                                                                                            </tr>
                                                                                                                                                                                                                                                                                                                                                                                            </thead>
                                                                                                                                                                                                                                                                                                                                                                                                            <tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                <% results.forEach(row => { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                        <tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <td><strong><%= row.party_abbreviation %></strong></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <td><%= row.total_score %></td>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <% }) %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            </tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </table>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                <% } else if (selectedLga) { %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            <p>No results found for this LGA.</p>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <% } %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </body>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </html>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        