<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Bincom Test - Question 1</title>
                <style>
                        body { font-family: -apple-system, sans-serif; padding: 20px; background-color: #f4f4f9; }
                                .container { max-width: 600px; margin: 0 auto; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
                                        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
                                                th, td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
                                                        th { background-color: #0056b3; color: white; }
                                                            </style>
                                                            </head>
                                                            <body>
                                                                <div class="container">
                                                                        <h2>Results for Polling Unit: <%= puId %></h2>
                          <a href="/" style="display:inline-block; margin-bottom:20px; color:#0056b3; text-decoration:none;">← Back to Home</a>

                                                                                <table>
                                                                                            <thead>
                                                                                                            <tr>
                                                                                                                                <th>Political Party</th>
                                                                                                                                                    <th>Score</th>
                                                                                                                                                                    </tr>
                                                                                                                                                                                </thead>
                                                                                                                                                                                            <tbody>
                                                                                                                                                                                                            <% if (results.length > 0) { %>
                                                                                                                                                                                                                                <% results.forEach(row => { %>
                                                                                                                                                                                                                                                        <tr>
                                                                                                                                                                                                                                                                                    <td><strong><%= row.party_abbreviation %></strong></td>
                                                                                                                                                                                                                                                                                                                <td><%= row.party_score %></td>
                                                                                                                                                                                                                                                                                                                                        </tr>
                                                                                                                                                                                                                                                                                                                                                            <% }) %>
                                                                                                                                                                                                                                                                                                                                                                            <% } else { %>
                                                                                                                                                                                                                                                                                                                                                                                                <tr>
                                                                                                                                                                                                                                                                                                                                                                                                                        <td colspan="2">No results found for this polling unit.</td>
                                                                                                                                                                                                                                                                                                                                                                                                                                            </tr>
                                                                                                                                                                                                                                                                                                                                                                                                                                                            <% } %>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        </tbody>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                </table>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </body>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </html>
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
