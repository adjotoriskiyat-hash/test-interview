<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>Bincom Test - Question 3</title>
                <style>
                        body { font-family: -apple-system, sans-serif; padding: 20px; background-color: #f4f4f9; }
                                .container { max-width: 500px; margin: 0 auto; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
                                        .form-group { margin-bottom: 15px; }
                                                label { display: block; margin-bottom: 5px; font-weight: bold; }
                                                        input { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
                                                                button { width: 100%; padding: 10px; background-color: #000; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 16px; margin-top: 10px; }
                                                                        .success { color: green; font-weight: bold; padding: 10px; background: #e8f5e9; border-radius: 4px; margin-bottom: 15px; }
                                                                            </style>
                                                                            </head>
                                                                            <body>
                                                                                <div class="container">
                                                                                        <h2>Add New Polling Unit Results</h2>
                    <a href="/" style="display:inline-block; margin-bottom:20px; color:#0056b3; text-decoration:none;">← Back to Home</a>

                                                                                                
                                                                                                        <% if (typeof success !== 'undefined' && success) { %>
                                                                                                                    <div class="success">✅ Results successfully saved to the database!</div>
                                                                                                                            <% } %>

                                                                                                                                    <form method="POST" action="/question3">
                                                                                                                                                <div class="form-group">
                                                                                                                                                                <label>Polling Unit Unique ID:</label>
                                                                                                                                                                                <input type="number" name="pu_id" required placeholder="e.g., 50">
                                                                                                                                                                                            </div>
                                                                                                                                                                                                        
                                                                                                                                                                                                                    <h3>Party Scores</h3>
                                                                                                                                                                                                                                <div class="form-group"><label>PDP:</label><input type="number" name="PDP" value="0" required></div>
                                                                                                                                                                                                                                            <div class="form-group"><label>DPP:</label><input type="number" name="DPP" value="0" required></div>
                                                                                                                                                                                                                                                        <div class="form-group"><label>ACN:</label><input type="number" name="ACN" value="0" required></div>
                                                                                                                                                                                                                                                                    <div class="form-group"><label>PPA:</label><input type="number" name="PPA" value="0" required></div>
                                                                                                                                                                                                                                                                                <div class="form-group"><label>CDC:</label><input type="number" name="CDC" value="0" required></div>
                                                                                                                                                                                                                                                                                            <div class="form-group"><label>JP:</label><input type="number" name="JP" value="0" required></div>

                                                                                                                                                                                                                                                                                                        <button type="submit">Submit Results</button>
                                                                                                                                                                                                                                                                                                                </form>
                                                                                                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                                                                                                    </body>
                                                                                                                                                                                                                                                                                                                    </html>
                                                                                                                                                                                                                                                                                                                    
